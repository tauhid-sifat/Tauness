name: Investigation
description: A bounded question or spike
title: "[Investigation] "
labels: ["type:investigation"]
body:
  - type: input
    id: summary
    attributes: { label: Summary }
    validations: { required: true }
  - type: textarea
    id: question
    attributes: { label: Question }
    validations: { required: true }
  - type: textarea
    id: options
    attributes: { label: Options / hypotheses }
  - type: input
    id: timebox
    attributes: { label: Timebox }
  - type: textarea
    id: needs
    attributes: { label: Decision needed after results }
  - type: dropdown
    id: phase
    attributes: { label: Phase, options: [{{PHASE_OPTIONS_YAML}}] }
    validations: { required: true }
  - type: dropdown
    id: area
    attributes: { label: Area, options: [{{AREA_OPTIONS_YAML}}] }
    validations: { required: true }
