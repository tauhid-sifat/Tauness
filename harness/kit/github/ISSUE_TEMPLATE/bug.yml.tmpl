name: Bug
description: A defect with reproducible evidence
title: "[Bug] "
labels: ["type:bug"]
body:
  - type: input
    id: summary
    attributes: { label: Summary }
    validations: { required: true }
  - type: input
    id: env
    attributes: { label: Environment }
    validations: { required: true }
  - type: textarea
    id: steps
    attributes: { label: Steps to reproduce }
    validations: { required: true }
  - type: textarea
    id: expected
    attributes: { label: Expected / actual }
    validations: { required: true }
  - type: dropdown
    id: severity
    attributes: { label: Severity, options: ["P0", "P1", "P2", "P3"] }
    validations: { required: true }
  - type: textarea
    id: evidence
    attributes: { label: Evidence (logs, screenshots, commands) }
  - type: input
    id: requirements
    attributes: { label: Requirement IDs, placeholder: "{{ID_PREFIX}}-AC-###-# or N/A" }
  - type: dropdown
    id: phase
    attributes: { label: Phase, options: [{{PHASE_OPTIONS_YAML}}] }
    validations: { required: true }
  - type: dropdown
    id: area
    attributes: { label: Area, options: [{{AREA_OPTIONS_YAML}}] }
    validations: { required: true }
  - type: textarea
    id: regression
    attributes: { label: Regression risk }
