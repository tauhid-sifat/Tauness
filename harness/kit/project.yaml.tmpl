# project.yaml — {{PROJECT_NAME}}
# Project configuration layer (Layer B). The single per-project input for the harness.
# Every value here is substituted into kit templates by init-project.ps1 / apply-harness-change.ps1.
# Editing this file is a harness-visible change: commit it via PR; the PM records material edits.

project:
  name: "{{PROJECT_NAME}}"
  slug: "{{PROJECT_SLUG}}"            # lowercase kebab; used in paths/branch naming
  id_prefix: "{{ID_PREFIX}}"          # uppercase short prefix for all IDs: REQ/US/AC/TC/DEF/DEC/ADR/CR/CAP/BR/ENT/PROC/SRC/Q/ACT
  description: "{{ONE_LINE_PROJECT_DESCRIPTION}}"

owner:
  login: "{{OWNER_GITHUB_LOGIN}}"     # GitHub login — the single human authority
  # Approvals, merges, phase transitions, and production deployment are owner-only (see governance docs).

repository:
  host: github.com
  visibility: private                 # private | public
  remote: "{{GIT_REMOTE_URL}}"        # set after the remote exists; empty is valid
  default_branch: main

lifecycle:
  profile: "{{LIFECYCLE_PROFILE}}"    # full | lean | headless | brownfield | micro (see harness/kit/lifecycle/profiles.yaml)
  gates: owner-approved               # do not change without an approved harness change
  areas: [{{AREA_LIST}}]              # issue/project Areas, e.g. [web, api, data, auth, infra, docs]

stack:                                # what the project is built with; drives rendered permissions
  name: "{{STACK_NAME}}"              # human description, e.g. "Next.js + Supabase", "Python FastAPI", "static site"
  source_dirs: [{{SOURCE_GLOBS}}]     # code dirs; edit-denied project-wide and re-allowed only for the Developer
  dev_commands: [{{DEV_COMMAND_LIST}}]     # exact shell prefixes the Developer may run, e.g. ["pnpm lint", "pnpm test", "pnpm build", "pnpm dev", "pnpm install", "npm ci"]
  qa_commands: [{{QA_COMMAND_LIST}}]       # QA-runnable commands, e.g. ["pnpm test", "pnpm build", "pnpm dev", "npx playwright test"]
  reviewer_commands: [{{REVIEW_COMMAND_LIST}}]  # review-time checks, e.g. ["pnpm test", "pnpm lint", "pnpm typecheck"]
  security_commands: [{{SECURITY_COMMAND_LIST}}] # audit tools allowed to the Security Monitor, e.g. ["npm audit", "pnpm audit"]
  hard_deny_commands: [{{HARD_DENY_LIST}}]  # extra never-allowed command prefixes (policies layer)
  deploy_commands: [{{DEPLOY_CLI_LIST}}]   # deploy CLIs that must NEVER run locally, e.g. ["vercel", "supabase"] → rendered as permission + policy denies
  browser: "{{BROWSER_BASE_URL}}"     # local base URL QA may hit, typically http://localhost:3000
  agent_skills: [{{STACK_SKILLS_LIST}}] # extra project-scoped skill IDs allowed for the Developer, e.g. ["setup-ts-deep-modules"]

skills:                                 # authoritative skill allow-lists; the kit ships none
  shared: [{{SKILLS_SHARED}}]           # every role may load these
  project-manager: []                   # per-role additions; edit this file to grant more. A role
  business-analyst: []                  # allowing a skill not declared here fails validate-harness.
  designer: []                          # design_system_tools/browser_live grants are added by the
  developer: []                         # renderer automatically; stack.agent_skills adds to developer.
  qa-engineer: []
  code-reviewer: []
  security-monitor: []

data_policy:
  sensitivity: "{{DATA_SENSITIVITY}}" # public | business | personal | regulated
  rules:
    - "Do not send {{SENSITIVE_DATA_LABEL}} data to external AI, scraping, browser, or research services until the owner approves the regime/policy."
    - "No secrets, credentials, .env files, or personal data in Git, issues, PRs, logs, or knowledge bundles."

integrations:                         # modular toggles; false entries render as denies and disabled MCP servers
  github_issues: true                 # work ledger via gh CLI (OD: gh CLI only, no GitHub MCP without owner approval)
  github_projects_v2: {{USE_PROJECTS_V2}}   # requires `project` + `read:project` token scopes
  open_knowledge: false               # retrieval layer pilot (see docs/harness/knowledge-management.md); true adds disabled mcp.servers entries (enabled: false until pilot)
  open_knowledge_path: "okn.exe"      # absolute path to okn binary when piloted
  browser_live: {{USE_LIVE_BROWSER}}  # BrowserOS Neo or equivalent live-browser MCP for QA/Designer verification
  web_research: false                 # Firecrawl or similar external research (renders as ask); never for sensitive data
  design_system_tools: {{USE_DESIGN_TOOLS}}   # Hallmark/Impeccable (UI projects); ignored by headless profiles
  mcp_deny: ["composio_*", "jira_*", "pencil_*"]  # additional MCP tool prefixes denied at project level

models:                               # model IDs are chosen by the owner here; no model is hard-coded in the kit
  default: "{{MODEL_WORK}}"           # the work model: PM, BA, Designer, Developer, QA
  reviewer: "{{MODEL_REVIEW}}"        # the review model: Code Reviewer and Security Monitor (independence is structural)
  readiness: "{{MODEL_READINESS}}"    # "verified" | "gated" — gated forbids real sessions (model-readiness gate)

workspace:
  docs_dir: docs/project
  knowledge_dir: docs/project/knowledge
  working_notes_dir: docs/project/working

# harness bookkeeping — written by the scripts; do not edit by hand
harness:
  kit_version: "{{KIT_VERSION}}"
  rendered_from_commit: "{{KIT_COMMIT}}"
  rendered_at: "{{RENDER_TIMESTAMP}}"
