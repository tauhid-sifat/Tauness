name: Requirement
description: A business or product requirement
title: "[Requirement] "
labels: ["type:requirement"]
body:
  - type: input
    id: summary
    attributes: { label: Summary }
    validations: { required: true }
  - type: textarea
    id: context
    attributes: { label: Context / problem }
    validations: { required: true }
  - type: input
    id: docs
    attributes: { label: BRD/PRD or knowledge page link }
  - type: textarea
    id: acceptance
    attributes: { label: Acceptance criteria }
    validations: { required: true }
  - type: input
    id: requirements
    attributes: { label: Requirement IDs, placeholder: "{{ID_PREFIX}}-REQ-###" }
    validations: { required: true }
  - type: textarea
    id: rules
    attributes: { label: Business rules / NFRs }
  - type: dropdown
    id: phase
    attributes: { label: Phase, options: [{{PHASE_OPTIONS_YAML}}] }
    validations: { required: true }
  - type: dropdown
    id: area
    attributes: { label: Area, options: [{{AREA_OPTIONS_YAML}}] }
    validations: { required: true }
  - type: dropdown
    id: priority
    attributes: { label: Priority, options: ["P0", "P1", "P2", "P3"] }
    validations: { required: true }
  - type: textarea
    id: risks
    attributes: { label: Risks and assumptions }
  - type: checkboxes
    id: approval
    attributes:
      label: Owner decision
      options:
        - { label: Requires owner approval (material per OD-18) }
