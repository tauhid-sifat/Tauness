# Rule: third-party Actions must be version-pinned by SHA and owner-reviewed (supply-chain policy).
on:
  pull_request:
  schedule:
    - cron: '0 3 * * 1'

jobs:
  audit:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
