{
  // opencode.jsonc — {{PROJECT_NAME}}
  // GENERATED by harness/scripts/init-project.ps1 from harness/kit/config/opencode.jsonc.tmpl + project.yaml.
  // Do not hand-edit rules here: edit the core kit, then re-apply. Section order is load-bearing
  // (permissions are ordered; last match wins; agent rules are appended after these).
  // Core baseline: {{KIT_VERSION}} (commit {{KIT_COMMIT}}) — changes to this file require an
  // owner-approved harness change (AGENTS.md §2).
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "project-manager",
  "instructions": ["AGENTS.md"],
  "worktree": { "directory": "worktrees" },
  "experimental": { "subagent_depth": 2 },

  "permissions": [
    // 0) Base: keep OpenCode's permissive defaults for benign built-ins (question, discovery tools).
    { "action": "*", "resource": "*", "effect": "allow" },

    // 1) Secrets: no agent may read or edit secret material. Overridable by nothing below except
    //    agent-level allow — and no role is permitted to allow it (AGENTS.md non-negotiable).
    { "action": "read", "resource": "**/.env", "effect": "deny" },
    { "action": "read", "resource": "**/.env.*", "effect": "deny" },
    { "action": "read", "resource": "**/.env.example", "effect": "allow" },
    { "action": "read", "resource": "**/*.pem", "effect": "deny" },
    { "action": "read", "resource": "**/*.key", "effect": "deny" },
    { "action": "read", "resource": "**/*.p12", "effect": "deny" },
    { "action": "read", "resource": "**/*.pfx", "effect": "deny" },
    { "action": "read", "resource": "**/.ssh/**", "effect": "deny" },
    { "action": "read", "resource": "**/id_rsa*", "effect": "deny" },
    { "action": "read", "resource": "**/id_ed25519*", "effect": "deny" },
    { "action": "edit", "resource": "**/.env", "effect": "deny" },
    { "action": "edit", "resource": "**/.env.*", "effect": "deny" },

    // 2) Protected paths (governance boundaries). Roles own their domain by agent-level allow only.
    { "action": "edit", "resource": ".git/**", "effect": "deny" },
    { "action": "edit", "resource": ".opencode/**", "effect": "deny" },
    { "action": "edit", "resource": ".agents/**", "effect": "deny" },
    { "action": "edit", "resource": ".github/**", "effect": "deny" },
    { "action": "edit", "resource": "harness/**", "effect": "deny" },
    { "action": "edit", "resource": "bootstrap/**", "effect": "deny" },
    { "action": "edit", "resource": "AGENTS.md", "effect": "deny" },
    { "action": "edit", "resource": "opencode.jsonc", "effect": "deny" },
    { "action": "edit", "resource": "project.yaml", "effect": "deny" },
    { "action": "edit", "resource": "docs/harness/**", "effect": "deny" },
    { "action": "edit", "resource": "DESIGN.md", "effect": "deny" },
    { "action": "edit", "resource": "docs/project/**", "effect": "deny" },
    { "action": "edit", "resource": "worktrees/**", "effect": "deny" },

    // 3) Shell: deny by default. Each role's agent file allows its narrow command set.
    //    This replaces the old `shell * ask` baseline: ask is not enforcement (--auto approves it).
    { "action": "shell", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "opencode *", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },

    // 4) Registry/package publishing is never an agent action (deploy runs only in CI).
    { "action": "shell", "resource": "npm publish*", "effect": "deny" },
    { "action": "shell", "resource": "pnpm publish*", "effect": "deny" },
    { "action": "shell", "resource": "yarn publish*", "effect": "deny" },

    // 5) Outbound web defaults to ask; roles with research needs allow per their agent rules.
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "websearch", "resource": "*", "effect": "ask" },

    // 6) Outside the workspace requires a human every time.
    { "action": "external_directory", "resource": "*", "effect": "ask" },

    // 7) Delegation and skills: deny-all baseline; each agent file re-allows its exact list.
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "*", "effect": "deny" },

    // 8) MCP egress: deny global non-essential servers (OD-24 default-deny). Agents must not
    //    re-allow any of these. Keep this list current via validate-harness.ps1 MCP audit.
{{MCP_DENY_RULES}}

    // 9) Project-stack deploy/database denials (from project.yaml stack.deploy_commands).
    //    Belt-and-braces: shell deny-by-default already blocks unlisted commands.
{{STACK_DENY_RULES}}
  ],

  // Policies are evaluated AFTER all permission rules and saved approvals: an agent rule,
  // a saved "always allow", or --auto cannot re-enable anything denied here. This is the
  // delegation-proof enforcement layer (ADR-H-004).
  "policies": [
    // Git irreversibility and dangerous push shapes. NOTE the two-layer push design:
    // the permissions section denies `git push*` for everyone, and the Developer agent file
    // re-allows ONLY `git push [origin|-u origin] <feature-prefix>/*`
    // prefixes (agent rules match last). Policies below are the shapes no rule may ever allow.
    { "action": "tool.use", "resource": "shell:git push", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push --force*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push -f*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push --delete*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push --mirror*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push origin main*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push -u origin main*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push origin phase/*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push origin release/*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git.exe push*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git reset --hard*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git clean*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git branch -D*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git filter-branch*", "effect": "deny" },
    // GitHub authority: no agent merges, approve-reviews, deletes, or raw API calls.
    { "action": "tool.use", "resource": "shell:gh pr merge*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh pr review --approve*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh pr review -a*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh *pr *merge*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh *pr *review*--approve*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh *pr *review*-a*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh api*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh *api*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh auth*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh secret*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh variable*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh repo *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh issue delete*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh workflow*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh release*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh codespace*", "effect": "deny" },
    // Shell writes that could bypass edit denies on protected paths and secrets.
    { "action": "tool.use", "resource": "shell:Set-Content*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:Add-Content*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:Out-File*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:Remove-Item*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:Move-Item*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:Copy-Item*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:New-Item*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rm *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:del *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:mv *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:cp *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:touch *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:chmod *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:chown *", "effect": "deny" },
    // Nested runtimes and general-purpose shells/interpreters that evade command allow-lists.
    { "action": "tool.use", "resource": "shell:opencode*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:powershell*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:pwsh*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:cmd *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:bash *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:wsl *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:sh *", "effect": "deny" },
    // Publishing / production mutation from any toolchain.
    { "action": "tool.use", "resource": "shell:npm publish*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:pnpm publish*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:yarn publish*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:docker push*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:twine upload*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:cargo publish*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:dotnet nuget push*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:mvn deploy*", "effect": "deny" },
    // Secret-bearing reads through shell readers (complements read denies).
    { "action": "tool.use", "resource": "shell:cat *.env*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:Get-Content*.env*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:type *.env*", "effect": "deny" }{{STACK_POLICY_DENY_RULES}}
  ],

  // MCP servers owned by the project. Disabled by default; enabling one is an owner-approved
  // harness change (OD-08/OD-24). Global servers are denied above; run validate-harness.ps1
  // after installing anything new so this list and the deny list stay in sync.
  "mcp": {
    "servers": {
{{MCP_SERVERS}}
    }
  }
}
