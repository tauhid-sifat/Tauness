# --- Harness: pending-apply staging area -------------------------------------
# harness/staging/ holds the instance preview and staged core docs produced by
# apply-harness-change.ps1. It contains rendered project values (layer C), which
# the published kit (layer A) must not carry. Kept locally, never committed.
harness/staging/

# --- Harness: generated artifacts --------------------------------------------
# Written by validate-harness.ps1 on every run.
harness/reports/

